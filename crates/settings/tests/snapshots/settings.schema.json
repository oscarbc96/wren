{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "description": "All user-visible settings.",
  "type": "object",
  "properties": {
    "search": {
      "$ref": "#/$defs/SearchSettings",
      "default": {
        "url": "https://duckduckgo.com/?q={query}"
      }
    },
    "startup": {
      "$ref": "#/$defs/StartupSettings",
      "default": {
        "restore_session": true
      }
    },
    "tabs": {
      "$ref": "#/$defs/TabSettings",
      "default": {
        "new_tab_url": "about:blank",
        "closed_stack": 25,
        "sleep_after_minutes": 30,
        "memory_budget_mb": 2048
      }
    },
    "sites": {
      "$ref": "#/$defs/SitesSettings",
      "default": {
        "open_in_chrome": []
      }
    },
    "adblock": {
      "$ref": "#/$defs/AdblockSettings",
      "default": {
        "enabled": true
      }
    },
    "downloads": {
      "$ref": "#/$defs/DownloadsSettings",
      "default": {
        "dir": "/Users/oscarblancocastan/Downloads"
      }
    },
    "hang": {
      "$ref": "#/$defs/HangSettings",
      "default": {
        "timeout_seconds": 5
      }
    },
    "devtools": {
      "$ref": "#/$defs/DevtoolsSettings",
      "default": {
        "enabled": false,
        "port": 6000
      }
    },
    "cdp": {
      "$ref": "#/$defs/CdpSettings",
      "default": {
        "enabled": false,
        "port": 9222
      }
    },
    "memory": {
      "$ref": "#/$defs/MemorySettings",
      "default": {
        "js_jit": true,
        "js_gc_profile": "default",
        "pressure_response": true
      }
    }
  },
  "$defs": {
    "SearchSettings": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "default": "https://duckduckgo.com/?q={query}"
        }
      }
    },
    "StartupSettings": {
      "type": "object",
      "properties": {
        "restore_session": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "TabSettings": {
      "type": "object",
      "properties": {
        "new_tab_url": {
          "type": "string",
          "default": "about:blank"
        },
        "closed_stack": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 25
        },
        "sleep_after_minutes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 30
        },
        "memory_budget_mb": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 2048
        }
      }
    },
    "SitesSettings": {
      "type": "object",
      "properties": {
        "open_in_chrome": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "AdblockSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "DownloadsSettings": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "default": "/Users/oscarblancocastan/Downloads"
        }
      }
    },
    "HangSettings": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 5
        }
      }
    },
    "DevtoolsSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Start Servo's remote debugging server (Firefox DevTools) at launch.",
          "type": "boolean",
          "default": false
        },
        "port": {
          "description": "Port on 127.0.0.1.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 6000
        }
      }
    },
    "CdpSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "description": "Start the Chrome DevTools Protocol server at launch.",
          "type": "boolean",
          "default": false
        },
        "port": {
          "description": "Port on 127.0.0.1.",
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 9222
        }
      }
    },
    "MemorySettings": {
      "type": "object",
      "properties": {
        "js_jit": {
          "type": "boolean",
          "default": true
        },
        "js_gc_profile": {
          "type": "string",
          "default": "default"
        },
        "pressure_response": {
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
