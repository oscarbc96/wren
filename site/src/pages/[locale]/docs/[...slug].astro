---
import type { GetStaticPaths } from "astro";
import DocsRoute from "@/components/DocsRoute.astro";
import { nonDefaultLocales } from "@/i18n";
import { source } from "@/lib/source";

export const prerender = true;

export const getStaticPaths = (() => {
  return nonDefaultLocales.flatMap((locale) =>
    source.getPages(locale).map((page) => ({
      params: { locale, slug: decodeURI(page.slugs.join("/")) || undefined },
      props: { page },
    })),
  );
}) satisfies GetStaticPaths;

const { locale } = Astro.params;
const { page } = Astro.props;
---

<DocsRoute locale={locale} page={page} />
